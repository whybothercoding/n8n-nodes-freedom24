{
	"name": "@indiegoweb/n8n-nodes-freedom24",
	"version": "0.2.4",
	"description": "n8n node for Freedom24/Tradernet Trading API",
	"license": "MIT",
	"homepage": "https://indiegoweb.com",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Indiegoweb Ltd",
		"email": "contact@indiegoweb.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/whybothercoding/n8n-nodes-freedom24.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
		"test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
		"test:coverage": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --coverage",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/Freedom24Api.credentials.js",
			"dist/credentials/Freedom24UserApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Freedom24/Freedom24.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^20.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.1.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}

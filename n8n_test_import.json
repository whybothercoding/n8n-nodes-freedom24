{
  "name": "[Test] Freedom24 Portfolio Analysis",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        300,
        150
      ]
    },
    {
      "parameters": {
        "resource": "portfolio",
        "operation": "getAll"
      },
      "id": "freedom24-node",
      "name": "Freedom24 (Get Portfolio)",
      "type": "n8n-nodes-base.freedom24",
      "typeVersion": 1,
      "position": [
        520,
        150
      ],
      "credentials": {
        "freedom24Api": {
          "id": "NEW_CREDENTIAL_ID",
          "name": "Freedom24 Account"
        }
      }
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "messages": {
          "values": [
            {
              "content": "Analyze my Freedom24 portfolio and provide a summary of my top holdings and total balance. Data: {{ JSON.stringify($json) }}"
            }
          ]
        }
      },
      "id": "gemini-node",
      "name": "Google Gemini (Analysis)",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [
        740,
        150
      ],
      "credentials": {
        "googleGeminiApi": {
          "id": "YOUR_GEMINI_CRED_ID",
          "name": "Google Gemini API"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Freedom24 (Get Portfolio)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Freedom24 (Get Portfolio)": {
      "main": [
        [
          {
            "node": "Google Gemini (Analysis)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Athens"
  },
  "meta": {
    "instanceId": "imported"
  }
}
